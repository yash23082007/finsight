{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main.py"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://finsight-ztxq.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "redirects": [
    {
      "source": "/transactions",
      "destination": "/#/transactions",
      "permanent": false
    },
    {
      "source": "/expense-analysis",
      "destination": "/#/expense-analysis",
      "permanent": false
    },
    {
      "source": "/budget",
      "destination": "/#/budget",
      "permanent": false
    },
    {
      "source": "/monthly-summary",
      "destination": "/#/monthly-summary",
      "permanent": false
    },
    {
      "source": "/insights",
      "destination": "/#/insights",
      "permanent": false
    },
    {
      "source": "/import-data",
      "destination": "/#/import-data",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "/#/settings",
      "permanent": false
    }
  ]
}
